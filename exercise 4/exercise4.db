db.people.aggregate([
  {$unwind:"$courses"},
  {$group:{
    _id:"$courses",
    total:{$sum:1}
          }},
  {
    $project:{course:"$_id",_id:0,total:1}
    
  },
  {$sort:{total:-1}}
  
])
{
  total: 3,
  course: 'js'
}
{
  total: 2,
  course: 'MongoDB'
}
{
  total: 2,
  course: 'React'
}
